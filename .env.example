# One OpenRouter key serves Jev (System One API), the website builder, and the TYPE_TEXT helper.
# Credentials stay server-side.
OPENROUTER_API_KEY=
TYPESAFE_MODEL=jev-latest
# Studio writes websites with this model; reasoning is off so code starts streaming in ~2 s.
BUILDER_MODEL=anthropic/claude-haiku-5.5
BUILDER_REASONING=none
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Voice: Fish Audio speech-to-text (and short spoken replies).
FISH_AUDIO_API_KEY=
FISH_AUDIO_LANGUAGE=en
# Optional: a Fish Audio voice model id for spoken replies.
FISH_AUDIO_VOICE=
