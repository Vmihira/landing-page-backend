# One OpenRouter key serves Jev (System One API) and the TYPE_TEXT helper. Credentials stay server-side.
OPENROUTER_API_KEY=
TYPESAFE_MODEL=jev-latest
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Voice input: Fish Audio speech-to-text turns a spoken task into the goal.
FISH_AUDIO_API_KEY=
FISH_AUDIO_LANGUAGE=en
